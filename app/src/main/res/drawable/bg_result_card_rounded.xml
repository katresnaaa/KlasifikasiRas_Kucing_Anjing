<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="0dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_color" />
            <corners android:radius="@dimen/corner_radius_large" />
        </shape>
    </item>
    
    <!-- Main card -->
    <item
        android:bottom="4dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_primary" />
            <corners android:radius="@dimen/corner_radius_large" />
        </shape>
    </item>
</layer-list>
