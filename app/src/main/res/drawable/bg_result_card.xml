<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="0dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_color" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>
    
    <!-- Main card -->
    <item
        android:bottom="4dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>
    
    <!-- Gradient border overlay -->
    <item
        android:bottom="4dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#3300BFA5"
                android:endColor="#3300897B"
                android:type="linear" />
            <corners android:radius="@dimen/corner_radius_medium" />
        </shape>
    </item>
</layer-list>
